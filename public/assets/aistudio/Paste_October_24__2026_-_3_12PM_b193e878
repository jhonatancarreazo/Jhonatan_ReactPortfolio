           VARIABLES Y RESET
           ========================================================================== */
        :root {
            --color-primary: #0f172a; /* Slate 900 - Textos principales */
            --color-secondary: #334155; /* Slate 700 - Textos secundarios */
            --color-accent: #2563eb; /* Blue 600 - Enlaces y detalles */
